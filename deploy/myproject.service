[Unit]
Description=Gunicorn service for the digitalOcean Flask site
Wants=network-online.target
After=network-online.target redis-server.service
Requires=redis-server.service

[Service]
User=deploy
Group=www-data
WorkingDirectory=/srv/digitalOcean
Environment="PATH=/srv/digitalOcean/.venv/bin"
EnvironmentFile=/etc/myproject/myproject.env
RuntimeDirectory=myproject
RuntimeDirectoryMode=0755
UMask=0007
ExecStart=/srv/digitalOcean/.venv/bin/gunicorn --workers 3 --bind unix:/run/myproject/myproject.sock wsgi:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
